{
  "name": "job-application-copilot",
  "displayName": "Job Application Copilot",
  "version": "0.1.0",
  "description": "Local-first resume parser and job application form filler. All profile data stays on your machine.",
  "author": "Job Application Copilot",
  "scripts": {
    "dev": "node scripts/plasmo-with-worker.cjs dev",
    "build": "node scripts/plasmo-with-worker.cjs build",
    "package": "plasmo package && node scripts/copy-pdf-worker-to-build.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-pdf-worker.cjs && node scripts/write-icon.cjs && node scripts/generate-sample-pdf.cjs"
  },
  "dependencies": {
    "mammoth": "^1.9.0",
    "pdfjs-dist": "4.10.38",
    "plasmo": "^0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "20.17.10",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "5.3.3",
    "vitest": "^2.1.8"
  },
  "manifest": {
    "name": "Job Application Copilot",
    "permissions": ["activeTab"],
    "host_permissions": ["http://*/*", "https://*/*"],
    "web_accessible_resources": [
      {
        "resources": ["pdf.worker.min.mjs"],
        "matches": ["http://*/*", "https://*/*"]
      }
    ]
  }
}
